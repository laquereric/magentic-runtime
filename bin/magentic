#!/usr/bin/env ruby
# frozen_string_literal: true
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "magentic/runtime"
require "json"
require "fileutils"

def fail_out(r); warn "REFUSED (#{r[:reason]}): #{r[:because]}"; exit 1; end
def fail_dav(r); warn "DAV error #{r[:code]}: #{r[:because] || r[:reason]}"; exit 1; end

def opts(argv)
  o = {}
  while (a = argv.shift)
    case a
    when "--out" then o[:out] = argv.shift
    when "--model" then o[:model] = argv.shift
    when "--image" then o[:image] = argv.shift
    when "--approver" then o[:approver] = argv.shift
    when "--root" then o[:root] = argv.shift
    when "--port" then o[:port] = argv.shift
    when "--host" then o[:host] = argv.shift
    when "--input" then o[:input] = argv.shift
    when "--pod" then o[:pod] = argv.shift
    when "--principal" then o[:principal] = argv.shift
    when "--delegate" then o[:delegate] = argv.shift
    when "--delegated" then o[:delegated] = argv.shift
    when "--release" then o[:release] = argv.shift
    when "--rev" then o[:rev] = argv.shift
    when "--pod-url" then o[:pod_url] = argv.shift
    end
  end
  o
end

def context_from(o)
  return nil unless o[:principal] || o[:pod] || o[:delegate]
  Magentic::Runtime::PodContext.new(
    pod_id: o[:pod] || "local", principal: o[:principal] || "Human:local-developer",
    delegate: o[:delegate], delegated: (o[:delegated] && o[:delegated].split(",")),
    release_sha: o[:release], workspace_revision: o[:rev]
  )
end

cmd = ARGV.shift
case cmd
when "init"
  dir = ARGV[0] || "."
  FileUtils.mkdir_p(File.join(dir, "flows"))
  FileUtils.cp(File.expand_path("../flows/todo.yaml", __dir__), File.join(dir, "flows", "todo.yaml"))
  puts "wrote #{File.join(dir, 'flows', 'todo.yaml')}"
when "run"
  flow = ARGV.shift; o = opts(ARGV); out = o[:out] || "./out"
  abort("usage: magentic run <flow.yaml> [--out DIR]") unless flow && File.file?(flow)
  r = Magentic::Runtime.run(flow, out_dir: out, model: o[:model]); fail_out(r) unless r[:ok]
  puts "OK candidate ready -- next: magentic approve --out #{out}"
when "approve"
  o = opts(ARGV); out = o[:out] || "./out"
  r = Magentic::Runtime.approve(out, approver: o[:approver] || "local-developer"); fail_out(r) unless r[:ok]
  puts "OK released by #{r[:approved_by]}  packet=#{r[:packet_sha256]}"
when "package"
  o = opts(ARGV); out = o[:out] || "./out"
  r = Magentic::Runtime.package(out, image: o[:image]); fail_out(r) unless r[:ok]
  puts "OK component  image=#{r[:image]}  component_digest=#{r[:component_digest]}"
when "serve"
  o = opts(ARGV); root = o[:root] || ENV["MAGENTIC_ROOT"] || "/work"; port = (o[:port] || 4700).to_i
  puts "magentic WebDAV serving #{root} on port #{port} (immutable/=RO, mutable/=RW)"
  Magentic::Runtime::Dav::Server.serve(root: root, port: port, host: (o[:host] || "0.0.0.0"))
when "ls"
  r = Magentic::Runtime::Dav::Client.new.ls(ARGV[0] || "/"); fail_dav(r) unless r[:ok]
  r[:entries].each { |e| puts "#{e['dir'] ? 'd' : '-'} #{e['path']}" }
when "cp"
  src, dst = ARGV.shift(2); abort("usage: magentic cp <src> <dst>") unless src && dst
  r = Magentic::Runtime::Dav::Client.new.cp(src, dst); fail_dav(r) unless r[:ok]; puts "copied #{src} -> #{dst}"
when "rm"
  path = ARGV.shift; abort("usage: magentic rm <path>") unless path
  r = Magentic::Runtime::Dav::Client.new.rm(path); fail_dav(r) unless r[:ok]; puts "removed #{path}"
when "promote"
  o = opts(ARGV); out = o[:out] || "./out"; pod = o[:pod] || "pod-local"
  r = Magentic::Runtime.promote(out, pod_id: pod, pod_url: (o[:pod_url] || ENV["MAGENTIC_POD_URL"]))
  fail_out(r) unless r[:ok]
  puts "OK promoted #{out} -> #{pod} via TrustLadder plugin gateway (gated=#{r[:gated]} egressed=#{r[:egressed]})"
when "mcp2"
  sub = ARGV.shift
  action = (sub == "invoke") ? ARGV.shift : nil
  o = opts(ARGV)
  m = Magentic::Runtime.mcp2(context: context_from(o))
  warn "Active Pod Context: #{m.context.label}"
  if sub == "discover"
    puts JSON.pretty_generate(m.discover)
  elsif sub == "invoke"
    puts JSON.pretty_generate(m.invoke(action: action, input: JSON.parse(o[:input] || "{}")))
  else
    puts "usage: magentic mcp2 discover | mcp2 invoke <action> --input JSON  [--pod ID --principal Human:x --delegate AI:y --delegated run,ls]"
  end
else
  puts "magentic - governed AI/human flow runtime (The Magentic Stack)"
  puts "  run/approve/package --out DIR         the governed flow acts"
  puts "  serve --root DIR --port N             serve the workspace over WebDAV (immutable RO / mutable RW)"
  puts "  ls|cp|rm ...                          fs primitives over the container WebDAV (no volume mounts)"
  puts "  promote --out DIR --pod POD [--pod-url URL]   container -> plugin gateway -> POD (never direct)"
  puts "  mcp2 discover | mcp2 invoke <action>  the STATELESS one-tool the Cyborg sees (binds an Active Pod Context)"
end
